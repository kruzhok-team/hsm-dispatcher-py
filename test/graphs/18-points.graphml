<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <data key="gFormat">Cyberiada-GraphML-1.0</data>
  <key id="gFormat" for="graphml" attr.name="format" attr.type="string"/>
  <key id="dName" for="graph" attr.name="name" attr.type="string"/>
  <key id="dName" for="node" attr.name="name" attr.type="string"/>
  <key id="dStateMachine" for="graph" attr.name="stateMachine"/>
  <key id="dRegion" for="graph" attr.name="region"/>
  <key id="dSubmachineState" for="node" attr.name="submachineState" attr.type="string"/>
  <key id="dGeometry" for="graph" attr.name="geometry"/>
  <key id="dGeometry" for="node" attr.name="geometry"/>
  <key id="dGeometry" for="edge" attr.name="geometry"/>
  <key id="dSourcePoint" for="edge" attr.name="sourcePoint"/>
  <key id="dTargetPoint" for="edge" attr.name="targetPoint"/>
  <key id="dLabelGeometry" for="edge" attr.name="labelGeometry"/>
  <key id="dNote" for="node" attr.name="note" attr.type="string"/>
  <key id="dVertex" for="node" attr.name="vertex" attr.type="string"/>
  <key id="dData" for="node" attr.name="data" attr.type="string"/>
  <key id="dData" for="edge" attr.name="data" attr.type="string"/>
  <key id="dPivot" for="edge" attr.name="pivot" attr.type="string"/>
  <key id="dChunk" for="edge" attr.name="chunk" attr.type="string"/>
  <key id="dCollapsed" for="node" attr.name="collapsed"/>
  <key id="dMarkup" for="node" attr.name="markup" attr.type="string"/>
  <key id="dColor" for="node" attr.name="color" attr.type="string"/>
  <key id="dColor" for="edge" attr.name="color" attr.type="string"/>
  <key id="dFormalName" for="graph" attr.name="formalName" attr.type="string"/>
  <key id="dFormalName" for="node" attr.name="formalName" attr.type="string"/>
  <graph id="G" edgedefault="directed">
    <data key="dStateMachine"/>
    <data key="dName">Points</data>
    <node id="nMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0</data>
    </node>
    <node id="c_log">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT log</data>
      <data key="dData">type/ Log</data>
    </node>
    <node id="init">
      <data key="dVertex">initial</data>
    </node>
    <node id="s">
      <data key="dName">S</data>
      <data key="dData">entry/
log.print('enter S')

exit/
log.print('exit S')</data>
    </node>
    <node id="c">
      <data key="dName">C</data>
      <data key="dData">entry/
log.print('enter C')

exit/
log.print('exit C')</data>
      <graph id="c:" edgedefault="directed">
        <data key="dRegion"/>
        <node id="cinit">
          <data key="dVertex">initial</data>
        </node>
        <node id="c1">
          <data key="dName">C1</data>
          <data key="dData">entry/
log.print('enter C1')

exit/
log.print('exit C1')</data>
        </node>
        <node id="c2">
          <data key="dName">C2</data>
          <data key="dData">entry/
log.print('enter C2')

exit/
log.print('exit C2')</data>
        </node>
        <node id="cin">
          <data key="dVertex">entryPoint</data>
          <data key="dName">In</data>
        </node>
        <node id="cout">
          <data key="dVertex">exitPoint</data>
          <data key="dName">Out</data>
        </node>
      </graph>
    </node>
    <node id="d">
      <data key="dName">D</data>
      <data key="dData">entry/
log.print('enter D')

exit/
log.print('exit D')</data>
    </node>
    <node id="w">
      <data key="dName">W</data>
      <data key="dData">entry/
log.print('enter W')

exit/
log.print('exit W')</data>
      <graph id="w:" edgedefault="directed">
        <data key="dRegion"/>
        <node id="winit">
          <data key="dVertex">initial</data>
        </node>
        <node id="ea">
          <data key="dName">E</data>
          <data key="dData">entry/
log.print('enter E')

exit/
log.print('exit E')</data>
          <graph id="ea:" edgedefault="directed">
            <data key="dRegion"/>
            <node id="einit">
              <data key="dVertex">initial</data>
            </node>
            <node id="e1">
              <data key="dName">E1</data>
              <data key="dData">entry/
log.print('enter E1')

exit/
log.print('exit E1')</data>
            </node>
            <node id="quit">
              <data key="dVertex">exitPoint</data>
              <data key="dName">Quit</data>
            </node>
          </graph>
        </node>
      </graph>
    </node>
    <node id="bye">
      <data key="dVertex">exitPoint</data>
      <data key="dName">Bye</data>
    </node>
    <edge id="init-s" source="init" target="s"/>
    <edge id="s-cin" source="s" target="cin">
      <data key="dData">go/</data>
    </edge>
    <edge id="cinit-c1" source="cinit" target="c1"/>
    <edge id="cin-c2" source="cin" target="c2"/>
    <edge id="c2-cout" source="c2" target="cout">
      <data key="dData">done/
log.print('done')</data>
    </edge>
    <edge id="cout-d" source="cout" target="d"/>
    <edge id="d-w" source="d" target="w">
      <data key="dData">tow/</data>
    </edge>
    <edge id="winit-ea" source="winit" target="ea"/>
    <edge id="einit-e1" source="einit" target="e1"/>
    <edge id="e1-quit" source="e1" target="quit">
      <data key="dData">leave/
log.print('leave')</data>
    </edge>
    <edge id="w-bye" source="w" target="bye">
      <data key="dData">end/</data>
    </edge>
  </graph>
</graphml>
