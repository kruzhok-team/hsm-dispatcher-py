<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <data key="gFormat">Cyberiada-GraphML-1.0</data>
  <key id="gFormat" for="graphml" attr.name="format" attr.type="string"/>
  <key id="dName" for="graph" attr.name="name" attr.type="string"/>
  <key id="dName" for="node" attr.name="name" attr.type="string"/>
  <key id="dStateMachine" for="graph" attr.name="stateMachine"/>
  <key id="dRegion" for="graph" attr.name="region"/>
  <key id="dSubmachineState" for="node" attr.name="submachineState" attr.type="string"/>
  <key id="dGeometry" for="graph" attr.name="geometry"/>
  <key id="dGeometry" for="node" attr.name="geometry"/>
  <key id="dGeometry" for="edge" attr.name="geometry"/>
  <key id="dSourcePoint" for="edge" attr.name="sourcePoint"/>
  <key id="dTargetPoint" for="edge" attr.name="targetPoint"/>
  <key id="dLabelGeometry" for="edge" attr.name="labelGeometry"/>
  <key id="dNote" for="node" attr.name="note" attr.type="string"/>
  <key id="dVertex" for="node" attr.name="vertex" attr.type="string"/>
  <key id="dData" for="node" attr.name="data" attr.type="string"/>
  <key id="dData" for="edge" attr.name="data" attr.type="string"/>
  <key id="dPivot" for="edge" attr.name="pivot" attr.type="string"/>
  <key id="dChunk" for="edge" attr.name="chunk" attr.type="string"/>
  <key id="dCollapsed" for="node" attr.name="collapsed"/>
  <key id="dMarkup" for="node" attr.name="markup" attr.type="string"/>
  <key id="dColor" for="node" attr.name="color" attr.type="string"/>
  <key id="dColor" for="edge" attr.name="color" attr.type="string"/>
  <key id="dFormalName" for="graph" attr.name="formalName" attr.type="string"/>
  <key id="dFormalName" for="node" attr.name="formalName" attr.type="string"/>
  <graph id="G" edgedefault="directed">
    <data key="dStateMachine"/>
    <data key="dName">History</data>
    <node id="nMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0</data>
    </node>
    <node id="c_log">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT log</data>
      <data key="dData">type/ Log</data>
    </node>
    <node id="init">
      <data key="dVertex">initial</data>
    </node>
    <node id="p">
      <data key="dName">P</data>
      <data key="dData">entry/
log.print('enter P')

exit/
log.print('exit P')</data>
      <graph id="p:" edgedefault="directed">
        <data key="dRegion"/>
        <node id="pinit">
          <data key="dVertex">initial</data>
        </node>
        <node id="a">
          <data key="dName">A</data>
          <data key="dData">entry/
log.print('enter A')

exit/
log.print('exit A')</data>
        </node>
        <node id="b">
          <data key="dName">B</data>
          <data key="dData">entry/
log.print('enter B')

exit/
log.print('exit B')</data>
        </node>
        <node id="pfin">
          <data key="dVertex">final</data>
        </node>
        <node id="h">
          <data key="dVertex">shallowHistory</data>
        </node>
      </graph>
    </node>
    <node id="q">
      <data key="dName">Q</data>
      <data key="dData">entry/
log.print('enter Q')

exit/
log.print('exit Q')</data>
    </node>
    <node id="d">
      <data key="dName">D</data>
      <data key="dData">entry/
log.print('enter D')

exit/
log.print('exit D')</data>
      <graph id="d:" edgedefault="directed">
        <data key="dRegion"/>
        <node id="dinit">
          <data key="dVertex">initial</data>
        </node>
        <node id="d1">
          <data key="dName">D1</data>
          <data key="dData">entry/
log.print('enter D1')

exit/
log.print('exit D1')</data>
          <graph id="d1:" edgedefault="directed">
            <data key="dRegion"/>
            <node id="d1init">
              <data key="dVertex">initial</data>
            </node>
            <node id="x">
              <data key="dName">X</data>
              <data key="dData">entry/
log.print('enter X')

exit/
log.print('exit X')</data>
            </node>
            <node id="y">
              <data key="dName">Y</data>
              <data key="dData">entry/
log.print('enter Y')

exit/
log.print('exit Y')</data>
            </node>
          </graph>
        </node>
        <node id="dh">
          <data key="dVertex">deepHistory</data>
        </node>
      </graph>
    </node>
    <node id="p2">
      <data key="dName">P2</data>
      <data key="dData">entry/
log.print('enter P2')

exit/
log.print('exit P2')</data>
      <graph id="p2:" edgedefault="directed">
        <data key="dRegion"/>
        <node id="p2init">
          <data key="dVertex">initial</data>
        </node>
        <node id="c1">
          <data key="dName">C1</data>
          <data key="dData">entry/
log.print('enter C1')

exit/
log.print('exit C1')</data>
        </node>
        <node id="c2">
          <data key="dName">C2</data>
          <data key="dData">entry/
log.print('enter C2')

exit/
log.print('exit C2')</data>
        </node>
        <node id="h2">
          <data key="dVertex">shallowHistory</data>
        </node>
      </graph>
    </node>
    <edge id="init-p" source="init" target="p"/>
    <edge id="pinit-a" source="pinit" target="a"/>
    <edge id="a-b" source="a" target="b">
      <data key="dData">NEXT/</data>
    </edge>
    <edge id="b-pfin" source="b" target="pfin">
      <data key="dData">FIN/</data>
    </edge>
    <edge id="h-a" source="h" target="a"/>
    <edge id="p-q" source="p" target="q">
      <data key="dData">OUT/</data>
    </edge>
    <edge id="q-h" source="q" target="h">
      <data key="dData">BACK/</data>
    </edge>
    <edge id="dinit-d1" source="dinit" target="d1"/>
    <edge id="d1init-x" source="d1init" target="x"/>
    <edge id="x-y" source="x" target="y">
      <data key="dData">STEP/</data>
    </edge>
    <edge id="d-q" source="d" target="q">
      <data key="dData">OUT2/</data>
    </edge>
    <edge id="q-dh" source="q" target="dh">
      <data key="dData">DEEP/</data>
    </edge>
    <edge id="p2init-c1" source="p2init" target="c1"/>
    <edge id="c1-c2" source="c1" target="c2">
      <data key="dData">GO2/</data>
    </edge>
    <edge id="q-h2" source="q" target="h2">
      <data key="dData">H2/</data>
    </edge>
    <edge id="p2-q" source="p2" target="q">
      <data key="dData">OUT3/</data>
    </edge>
  </graph>
</graphml>
